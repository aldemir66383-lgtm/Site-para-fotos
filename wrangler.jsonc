{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fotoviva-photos",
  "main": "src/server/photos/worker.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "R2_ACCOUNT_ID": "REPLACE_ACCOUNT_ID",
    "R2_BUCKET_NAME": "fotoviva-private",
    "AUTH_JWKS_URL": "https://auth.example.com/.well-known/jwks.json",
    "AUTH_ISSUER": "https://auth.example.com/",
    "AUTH_AUDIENCE": "fotoviva",
    "MEDIA_SERVICE_URL": "https://media.example.com/process",
    "PUBLIC_SITE_URL": "https://fotoviva-pedromatosx-lab.pedromatos2050.workers.dev",
    "FV_FACE_SEARCH": "off",
    "FACE_MODEL_VERSION": "REPLACE_FACE_MODEL_VERSION",
    "FACE_EMBEDDING_DIMENSIONS": "128",
    "FACE_MAX_SCANNED_VECTORS": "30000",
    "FACE_CONSENT_RETENTION_DAYS": "90",
    "WHATSAPP_ENABLED": "off",
    "WHATSAPP_TEMPLATE_NAME": "aire_photos_download_ready",
    "WHATSAPP_TEMPLATE_LANGUAGE": "pt_BR"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "fotoviva",
    "database_id": "REPLACE_DATABASE_ID", "migrations_dir": "src/server/db/migrations"
  }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "fotoviva-private" }],
  "queues": {
    "producers": [{ "binding": "PHOTO_QUEUE", "queue": "fotoviva-photos" }],
    "consumers": [{
      "queue": "fotoviva-photos", "max_batch_size": 1,
      "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 8,
      "dead_letter_queue": "fotoviva-photos-dlq", "retry_delay": 60
    }]
  },
  "triggers": { "crons": ["*/2 * * * *", "*/10 * * * *"] }
}
