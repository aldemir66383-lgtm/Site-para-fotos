{
  "name": "fotoviva-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:media": "tsx src/server/media/service.ts",
    "build:media": "tsc -p tsconfig.media.json",
    "start:media": "node dist/media/service.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "deploy:check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply fotoviva --local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@zip.js/zip.js": "^2.24.0",
    "exifr": "^7.1.3",
    "google-auth-library": "^10.0.0",
    "jose": "^6.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
